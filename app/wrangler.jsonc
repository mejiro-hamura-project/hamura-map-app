{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hamura-map-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "POSTS_ENABLED": "false",
    "RALLY_SYNC_ENABLED": "false"
  },
  "previews": {}
}
